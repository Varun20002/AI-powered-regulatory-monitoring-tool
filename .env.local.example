# Copy to .env.local and fill in values.
# On Vercel: Project Settings → Environment Variables (use the same names).

# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM key (server only) — set in Vercel as MINIMAX_API_KEY.
# Defaults to MiniMax M2.7 via the OpenAI SDK. Any OpenAI-compatible endpoint works
# (OpenAI, Groq, Ollama, LiteLLM-fronted Anthropic, etc.) — change `baseURL` and model
# in src/lib/minimax.ts. See README → "Swap the LLM provider".
MINIMAX_API_KEY=your-minimax-api-key

# Random string. In production, set this so unauthenticated callers cannot POST /api/fetch.
# Dashboard "Fetch Now" uses a server action and does not need this in the browser.
# Optional: send as Authorization: Bearer <CRON_SECRET> on GET /api/fetch for manual cron tests.
CRON_SECRET=your-random-secret-here

# Optional — custom domain or stable preview URL if you need a fixed origin for webhooks later
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
